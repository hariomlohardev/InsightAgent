# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
STORAGE_PATH=./storage
MAX_UPLOAD_MB=100

# LLM Provider: auto | openai | groq | gemini | claude | ollama
LLM_PROVIDER=auto
LLM_MODEL=

# OpenAI (default)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Groq (fast, OpenAI-compatible) — get at https://console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.1-8b-instant

# Google Gemini — https://aistudio.google.com
GOOGLE_API_KEY=AIza...
# or GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# or CLAUDE_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Ollama (local, no key, 100% private) — https://ollama.com
# Run: ollama serve && ollama pull llama3.1:8b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# L6 Automation — SMTP/Slack (optional, simulated if missing; tests mock)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@insightagent.local
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_VERIFY=true
DEFAULT_DATASET_ID=

# L7 Enterprise — optional, all default to OSS frictionless (no auth/redis/s3)
AUTH_REQUIRED=false
ENTERPRISE=false
JWT_SECRET=change-me-in-prod-use-openssl-rand-hex-32
JWT_EXP_HOURS=24
REDIS_URL=redis://redis:6379/0
CACHE_TTL=60
USE_POLARS=false
STORAGE_BACKEND=fs
S3_BUCKET=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# L09 Data Foundation — optional, filesystem fallback when empty (contributor frictionless)
DATABASE_URL=
# e.g. DATABASE_URL=postgresql+asyncpg://insightagent:insightagent@localhost:5432/insightagent
# or for tests: DATABASE_URL=sqlite+aiosqlite:///./test.db
POSTGRES_USER=insightagent
POSTGRES_PASSWORD=insightagent
POSTGRES_DB=insightagent
POSTGRES_PORT=5432
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
# L8 Cloud — optional, all default to self-host OSS (CLOUD=false)
CLOUD=false
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_WEBHOOK_SECRET=whsec_mock
STRIPE_PRICE_PRO=price_mock_pro
STRIPE_PRICE_TEAM=price_mock_team
STRIPE_PRICE_ENTERPRISE=price_mock_enterprise
ENCRYPTION_KEY=dev-encryption-key-change-in-prod
OLLAMA_URL=http://ollama:11434

# Frontend
BACKEND_URL=http://localhost:8000
FRONTEND_AUTH_REQUIRED=false
CLOUD=false
